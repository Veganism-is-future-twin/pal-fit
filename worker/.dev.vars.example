# Copy this file to `.dev.vars` (same folder) for LOCAL development only.
# `.dev.vars` is gitignored. Never put real values in this example file.
#
# In production, set secrets with:  npx wrangler secret put <NAME>

# Shows a "developer login" on localhost (never works on the live site).
DEV_LOGIN=1

# Comma-separated OWNER emails: always admin, can't be removed or deactivated.
# (Other admins can be added in the app: Admin → Members.)
ADMIN_EMAILS=someone@example.com

# Any long random text. Encrypts API keys that admins save in the app.
SETTINGS_KEY=replace-with-long-random-text

# Optional: AI keys (normally pasted in the app under Admin → AI & keys).
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
