{
  "name": "pal-fit-api",
  "version": "0.1.0",
  "private": true,
  "description": "PAL Fitness backend — Cloudflare Worker + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
